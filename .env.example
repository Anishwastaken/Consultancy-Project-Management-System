# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# ---------------------------------------------------------------- Database
# MySQL (default). The server creates the database and tables on first start
# and loads the sample data. Use any account allowed to create a database
# (root is fine on your own machine).
DATA_STORE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cpts
# On a machine without MySQL, set DATA_STORE=json to use a local file instead.

# ------------------------------------------------------------------ E-mail
#
# E-mail for sign-in codes. Leave SMTP_HOST empty to run in development mode,
# where codes are printed in the server terminal instead of e-mailed.
#
# Gmail / Google Workspace (LNMIIT mail is Google): turn on 2-step verification
# for the sending account, create an App Password, and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CPTS <your.account@lnmiit.ac.in>"

# The demo accounts use made-up @lnmiit.ac.in addresses. While demoing, send
# every code to one inbox you control instead of to those addresses.
OTP_REDIRECT_TO=

# API port (the web dev server proxies /api to it)
PORT=3001

{
  "name": "cpts-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:reset": "tsx server/scripts/db-reset.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "0.511.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "4.1.8",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
